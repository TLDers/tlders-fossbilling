{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% block meta_title %}{{ 'TLDers Price Monitor settings'|trans }}{% endblock %}

{% set active_menu = 'system' %}

{% block content %}
{% set params = admin.extension_config_get({ 'ext': 'mod_tldersprices' }) %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">{{ 'TLDers Price Monitor settings'|trans }}</h3>
    </div>
    <div class="card-body">
        <form method="post" action="{{ 'extension/config_save'|api_url }}" {{ fb_api_form({message: 'Configuration updated'|trans}) }}>
            <input type="hidden" name="ext" value="mod_tldersprices" />
            <div class="mb-3 row">
                <label class="form-label col-3 col-form-label">{{ 'TLDers API key'|trans }}:</label>
                <div class="col">
                    <input class="form-control" type="password" name="apiKey" value="{{ params.apiKey|default('') }}" autocomplete="off">
                    <small class="form-hint">{{ 'Create a free key at'|trans }} <a href="https://www.tlders.com/developers" target="_blank" rel="noopener">tlders.com/developers</a>.</small>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="form-label col-3 col-form-label">{{ 'Flag when above market by (%)'|trans }}:</label>
                <div class="col">
                    <input class="form-control" type="text" name="threshold" value="{{ params.threshold|default(25) }}">
                </div>
            </div>
            <div class="mb-3 row">
                <label class="form-label col-3 col-form-label">{{ 'USD → your currency'|trans }}:</label>
                <div class="col">
                    <input class="form-control" type="text" name="usdRate" value="{{ params.usdRate|default('') }}">
                    <small class="form-hint">{{ 'Leave blank to use the USD rate from your currency settings.'|trans }}</small>
                </div>
            </div>
            <input type="submit" value="{{ 'Update'|trans }}" class="btn btn-primary">
        </form>
    </div>
</div>
{% endblock %}
